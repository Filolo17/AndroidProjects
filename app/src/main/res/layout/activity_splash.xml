<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ==================== ЭКРАН ЗАГРУЗКИ ==================== -->
    <LinearLayout
        android:id="@+id/splashGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- название сверху слева -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="40dp"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- слоган под названием -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="@string/slogan"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <!-- картинка по центру -->
        <ImageView
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/img_splash"
            android:contentDescription="Splash illustration" />

    </LinearLayout>

    <!-- ==================== ЭКРАН НЕТ ПОДКЛЮЧЕНИЯ ==================== -->
    <LinearLayout
        android:id="@+id/noInternetGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/img_no_internet"
            android:contentDescription="No internet" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/no_internet_title"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="32dp"
            android:text="@string/no_internet_subtitle"
            android:textColor="@color/gray_text"
            android:textSize="14sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="24dp"
            android:paddingVertical="14dp"
            android:text="@string/retry"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="@color/pink_primary"
            app:cornerRadius="24dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>